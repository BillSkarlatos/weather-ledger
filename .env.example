# Copy to .env, fill in, never commit.
DB_NAME=weather
DB_OWNER_USER=weather_owner
DB_OWNER_PASSWORD=
DB_INGEST_PASSWORD=
DB_READER_PASSWORD=

# https://www.weatherapi.com/signup.aspx (Free plan: 3 forecast days)
WEATHERAPI_KEY=
WEATHERAPI_MAX_DAYS=3
# Free Open-Meteo is non-commercial; commercial: https://customer-api.open-meteo.com + key
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENMETEO_API_KEY=
FORECAST_DAYS=3

SCHEDULE_TIME=06:00
SCHEDULE_TIMEZONE=Europe/Athens
RETRY_MINUTES=30

# Created by setup when no location exists
DEFAULT_LOCATION_NAME=Demo field
DEFAULT_LOCATION_LATITUDE=52.52
DEFAULT_LOCATION_LONGITUDE=13.41
DEFAULT_LOCATION_TIMEZONE=Europe/Berlin

# Comma-separated bearer tokens (openssl rand -hex 32)
API_TOKENS=
API_PORT=8080
