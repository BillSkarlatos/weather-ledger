#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../src/bootstrap.php';

try {
    exit((new App\Cli(new App\App()))->run(array_slice($argv, 1)));
} catch (Throwable $e) {
    fwrite(STDERR, ($e instanceof ArgumentCountError ? 'Wrong number of arguments' : $e->getMessage()) . PHP_EOL);
    exit(1);
}
